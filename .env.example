# Copy to .env.local and fill in. Never commit .env.local.
# Supabase dashboard → Project Settings → API. Use the *publishable* key only; never put the secret/service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# IANA timezone used to decide "today" for task due dates.
APP_TIMEZONE=Asia/Jakarta

# E-learning UNAIR (Moodle): URL kalender iCal pribadi. Moodle -> Kalender -> Impor atau ekspor kalender -> Ekspor kalender -> "Dapatkan URL kalender".
# URL ini berisi token rahasia: hanya di .env.local / env hosting, jangan di-commit, jangan dibagikan.
ELEARNING_ICAL_URL=

# Brief harian (opsional, berbayar per token). Kunci API dari console.anthropic.com. Server-only, jangan pakai NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
