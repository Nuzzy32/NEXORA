# Copy to .env.local and fill in. Never commit .env.local.
# Supabase dashboard → Project Settings → API. Use the *publishable* key only; never put the secret/service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# IANA timezone used to decide "today" for task due dates.
APP_TIMEZONE=Asia/Jakarta

# E-learning UNAIR (Moodle): URL kalender iCal pribadi. Moodle -> Kalender -> Impor atau ekspor kalender -> Ekspor kalender -> "Dapatkan URL kalender".
# URL ini berisi token rahasia: hanya di .env.local / env hosting, jangan di-commit, jangan dibagikan.
ELEARNING_ICAL_URL=

# Brief harian (opsional, berbayar per token). Kunci API dari console.anthropic.com. Server-only, jangan pakai NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Sinkron e-learning harian (Vercel Cron memanggil /api/cron/elearning). Semuanya server-only; isi juga di Environment Variables Vercel.
# CRON_SECRET: string acak panjang (mis. `openssl rand -hex 32`). OWNER_USER_ID: id akunmu di Supabase -> Authentication -> Users.
# SUPABASE_SERVICE_ROLE_KEY: "secret key" Supabase -> Project Settings -> API. Melewati RLS: jangan pernah di NEXT_PUBLIC_*, jangan di-commit.
CRON_SECRET=
OWNER_USER_ID=
SUPABASE_SERVICE_ROLE_KEY=

# Opsional (D-032). Fine-grained token GitHub, read-only ("Contents" dan "Issues"/"Pull requests": Read) untuk repo privat
# di tab Overview proyek. Repo publik bisa tanpa token. Server-only: jangan diawali NEXT_PUBLIC_.
GITHUB_TOKEN=
